{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "jsx": "react",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.js"]
}
